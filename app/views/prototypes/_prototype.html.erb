<div class="card">
    <% if prototype.image.attached?%>
      <%= link_to prototype_path(prototype)do %>
      <%= image_tag prototype.image. variant(resize: '300x300'), class: "card__img"%> 
      <% end %>
    <% end %>
  <div class="card__body">
    <%= link_to "プロトタイプのタイトル", prototype_path(prototype), class: :card__title%>
    <p class="card__summary">
      <%= "プロトタイプのキャッチコピー" %>
    </p>
    <%= link_to "by プロトタイプの投稿者名", prototype_path(prototype), class: :card__user %>
  </div>
</div>